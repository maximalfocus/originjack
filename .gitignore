# Transport material is generated at image-build time inside the containers and is
# never committed (NFR-003). These patterns are a backstop, not the primary control.
*.pem
*.key
*.crt
*.csr
*.srl
certs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Harness run artifacts (transcript, screenshots) are produced per run, never committed.
artifacts/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Editors / OS
.DS_Store
.idea/
.vscode/
